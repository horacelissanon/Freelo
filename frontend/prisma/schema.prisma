generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash            String?
  // Set by change-password/set-password on success — surfaced read-only in
  // Paramètres → Sécurité ("Dernière modification"). Not used for any auth
  // decision (tokenVersion already handles session invalidation).
  passwordChangedAt       DateTime?
  emailVerifiedAt         DateTime?
  tokenVersion            Int       @default(0)
  withdrawalPinHash       String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Display name — collected at signup for email/password accounts (POST
  // /api/auth/signup), populated from the OAuth profile on first sign-in for
  // Google accounts, editable later via /api/auth/me PATCH. Stays nullable
  // for rows created before this was required.
  name                    String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl               String?
  // Profile fields editable via PATCH /api/auth/me (Paramètres → Compte).
  phone                   String?
  bio                     String?
  // Workspace/business fields (Paramètres → Espace de travail).
  studioName              String?
  taxId                   String?
  // Registre de commerce (business registration number) — displayed on
  // devis/factures alongside the tax ID once the freelancer fills it in.
  commerceRegistry        String?
  address                 String?
  // Contact phone shown on devis/factures when documentIdentity=COMPANY —
  // deliberately separate from the personal `phone` field above, which only
  // ever surfaces under documentIdentity=PERSONAL.
  companyPhone            String?
  // Short tagline shown on devis/factures right under the provider name —
  // independent of documentIdentity (unlike address/taxId/commerceRegistry,
  // it applies whichever identity mode is active).
  slogan                  String?
  // Company logo (Cloudinary URL, same upload pipeline as avatarUrl) —
  // shown on devis/factures/PDF/tracking page header only when
  // documentIdentity=COMPANY AND the subscription is Pro (isProActive()).
  // Stored regardless of plan so a freelance who downgrades then re-upgrades
  // doesn't lose their upload; every render call site does its own Pro gate.
  logoUrl                 String?
  // Which identity shows in the header of this user's devis/factures:
  // PERSONAL (name/phone/bio) or COMPANY (studioName/address/taxId/
  // commerceRegistry). Set in Paramètres → Compte → Entreprise. Defaults to
  // COMPANY (matches the pre-existing studioName-first fallback behavior).
  documentIdentity        String    @default("COMPANY") // PERSONAL | COMPANY
  // Client-facing branding (Paramètres → Compte → Entreprise) — used on the
  // PDF footer band, the on-screen invoice footer, and the /suivi/[token]
  // tracking page footer. Independent from the dashboard-only accent color
  // (EspaceTab/AccentColorContext), which never leaves the browser.
  brandColor              String?   @default("#059669")
  // Pre-fills Invoice.footerNote on every new facture — stays freely
  // editable per invoice afterward.
  defaultLegalMention     String?
  defaultCurrency         String    @default("XOF")
  language                String    @default("fr")
  // showPaidInvoicesDefault: when false, /invoices pre-filters PAID docs out
  // of the initial view (still togglable via the existing filter tabs).
  showPaidInvoicesDefault Boolean   @default(true)
  // publicPortalEnabled: kill switch for this user's /suivi/[token] links —
  // when false, GET /api/track/[token] (+ comments/pay siblings) 404 for
  // all of this user's clients/projects, same shape as an invalid token.
  publicPortalEnabled     Boolean   @default(true)
  // Onboarding — null means the first-run setup wizard + product tour
  // haven't been completed or explicitly skipped yet; set once (never
  // reset) the first time the user finishes or dismisses it. The migration
  // backfills this to createdAt for every pre-existing row so only NEW
  // signups see the wizard, not the whole existing user base.
  onboardingCompletedAt   DateTime?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role                    String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status                  String    @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  verificationCodes     VerificationCode[]
  uploads               FileUpload[]
  notifications         Notification[]
  notifPrefs            NotificationPreferences?
  orders                Order[]
  withdrawals           Withdrawal[]
  oauthAccounts         OAuthAccount[]
  adminActions          AdminAction[]
  clients               Client[]
  projects              Project[]
  invoices              Invoice[]
  reviews               Review[]
  subscription          Subscription?
  sessions              Session[]
  defaultPaymentMethods DefaultPaymentMethod[]
  supportTickets        SupportTicket[]
  couponRedemptions     CouponRedemption[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]       @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")
  adminAlertsHandled AdminAlert[]

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Admin alerts — proactive operational/security signals for ADMIN/SUPERADMIN,
// distinct from AdminAction (which logs actions admins TAKE, not events that
// happen TO the platform) and from Notification (which is strictly
// user-scoped — one row always belongs to exactly one User). AdminAlert has
// no "owner": it's a platform-wide signal visible to every admin, picked up
// and acknowledged/resolved by whichever admin handles it.
//
// `dedupeKey` is the same at-most-once gate as Notification.dedupeKey —
// always deterministic per logical event/time-bucket, never a timestamp or
// random suffix (see lib/server/admin-alerts/index.ts::createAdminAlert).
// ───────────────────────────────────────────────────────────────────────
model AdminAlert {
  id                  String    @id @default(cuid())
  type                String // dotted category, e.g. "payments.circuit_open"
  severity            String // INFO | WARNING | CRITICAL
  title               String
  body                String
  data                Json?
  dedupeKey           String    @unique
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  acknowledgedByActor User?     @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([severity, acknowledgedAt, createdAt])
  @@index([type, createdAt])
}

// A freelancer's support request to the Merrudit team. Submitted from
// Paramètres → Support; triaged from the Super Admin console (/admin/support).
model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  priority  String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String               @id @default(cuid())
  slug      String               @unique
  name      String
  ownerId   String
  owner     User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([ownerId])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Device/session bookkeeping layered on top of the stateless refresh-token
// design in lib/server/auth.ts (which stays untouched — no jti embedded in
// the JWT itself). Identified by a separate, path-scoped device cookie
// (lib/server/sessions.ts) set alongside the auth cookies at login/signup.
// Revocation is enforced at the next refresh (≤15min staleness window,
// same tolerance already accepted for ACCOUNT_SUSPENDED in
// app/api/auth/refresh/route.ts) rather than instantly on the current
// access token — deliberately, to avoid touching the hot-path requireAuth
// check in the protected middleware/index.ts.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  // Best-effort geo-IP captured at session-creation time from Vercel's
  // x-vercel-ip-city/x-vercel-ip-country request headers (Sécurité →
  // Sessions actives). Both stay null outside Vercel (e.g. local dev) —
  // same graceful-degradation behavior as `ip` already has locally.
  city       String?
  country    String? // ISO 3166-1 alpha-2, e.g. "SN" — display name resolved client-side
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  url       String // Cloudinary secure_url — persisted at upload time since it can't be
  // deterministically reconstructed later from `key` alone (resource_type/format aren't stored)
  filename  String
  mimeType  String
  sizeBytes Int
  // Optional link to a Project — set when uploaded as a project deliverable
  // (see POST /api/upload's `projectId` field). Null for other upload
  // contexts (e.g. a future avatar uploader, or a chat-comment attachment,
  // which links via ProjectComment.attachmentUrl instead).
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([projectId])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id            String  @id @default(cuid())
  userId        String? // nullable — guest checkout supported
  user          User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount        Int // gross amount, smallest unit
  currency      String  @default("XOF") // ISO 4217
  status        String  @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail String?
  customerPhone String?
  customerName  String?
  metadata      Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey String? @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String @default("XOF")
  status      String @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}

// ───────────────────────────────────────────────────────────────────────
// Freelance CRM (Banani "Espace Freelance Merrudit" import, Phase A —
// see .planning/banani/IMPLEMENTATION-PLAN.md). Single-tenant: every row
// is owned by one freelancer `User`, no Organization involved.
//
// These are deliberately separate from Order/Withdrawal — Order models a
// buyer paying this app (marketplace checkout), while Invoice models a
// freelancer billing an EXTERNAL client who is not necessarily a User.
// The payment-collection loop (Phase C) composes on top of the existing
// guest-checkout Order path rather than duplicating payment logic here.
// ───────────────────────────────────────────────────────────────────────
model Client {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String   @unique // human-friendly disambiguator ("CL-0001"), sequential per user — assigned explicitly by POST /api/clients (see route for the retry-on-collision pattern)
  name          String
  contactName   String?
  email         String?
  phone         String?
  company       String?
  website       String?
  city          String?
  sector        String?
  notes         String?
  status        String   @default("new") // new | pending | active | archived — see lib/server/clients/status.ts
  imageUrl      String?
  trackingToken String   @unique @default(cuid()) // Client Link Portal (Phase C) — lists all of this client's projects
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
  invoices Invoice[]
  reviews  Review[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model Project {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId              String
  client                Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                  String
  sector                String    @default("OTHER") // Secteur freelance — DESIGN | DEV | REDACTION | CONSULTING | VIDEO | COMMUNITY | OTHER; scopes which `type` values the UI offers (see SECTOR_PROJECT_TYPES in lib/constants.ts)
  type                  String    @default("OTHER") // scoped to `sector` — see PROJECT_TYPE_LABELS in lib/constants.ts
  description           String? // short brief, freeform (v1)
  // DRAFT is the only freelance-chosen value (creation-time: "Enregistrer
  // brouillon" vs "Créer projet"). Once PENDING+, status is fully derived
  // from step completion (see lib/server/projects/progress.ts) and never
  // freelance-chosen again.
  status                String    @default("PENDING") // DRAFT | PENDING | IN_PROGRESS | IN_REVIEW | DELIVERED
  progress              Int       @default(0) // 0-100
  amount                Int // smallest currency unit, matches Order convention
  currency              String    @default("XOF")
  // Rate frozen at creation time: 1 unit of `currency` = X units of
  // User.defaultCurrency. Null when currency === defaultCurrency (implicit
  // rate of 1). Never recomputed automatically afterwards — the freelance
  // can edit it manually, but it doesn't track the live market rate.
  exchangeRateToDefault Float?
  dueDate               DateTime?
  step                  String? // current milestone label, freeform (v1)
  publicToken           String    @unique @default(cuid()) // Client Link Portal (Phase C)
  // Deposit terms for this project. NONE: no deposit expected, the whole
  // amount is due as balance. FIXED: depositValue is an amount in the
  // project's smallest currency unit. PERCENT (system default): depositValue
  // is a 0-100 rate applied to `amount`. Mirrors InvoicePack's depositType/
  // depositValue pattern below.
  depositType           String    @default("PERCENT") // NONE | FIXED | PERCENT
  depositValue          Int       @default(50)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  invoices Invoice[]
  steps    ProjectStep[]
  comments ProjectComment[]
  files    FileUpload[]
  review   Review?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([clientId])
}

model ProjectStep {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, order])
}

model ProjectComment {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         String // FREELANCER | CLIENT
  body           String // may be "" when attachmentUrl is set (photo/voice-only message)
  attachmentUrl  String?
  attachmentType String? // IMAGE | AUDIO
  createdAt      DateTime @default(now())

  @@index([projectId, createdAt])
}

model Invoice {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId              String
  client                Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  docType               String // INVOICE | QUOTE | CREDIT_NOTE
  number                String // "2025-001" / "QT-2025-008" / "AV-2025-003" — sequential per userId+docType
  description           String?
  // Denormalized total, always server-computed from lineItems (INVOICE) or
  // packs (QUOTE) — never accepted directly from the client. Kept in sync on
  // every create/edit so dashboard stats, InvoiceCard/InvoiceRow and the
  // invoices list keep reading this single Int with zero changes.
  amount                Int
  currency              String    @default("XOF")
  // Rate frozen at creation time: 1 unit of `currency` = X units of
  // User.defaultCurrency. Null when currency === defaultCurrency (implicit
  // rate of 1). Never recomputed automatically afterwards — the freelance
  // can edit it manually, but it doesn't track the live market rate.
  exchangeRateToDefault Float?
  status                String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | ACCEPTED | CANCELED
  issueDate             DateTime  @default(now())
  dueDate               DateTime?
  // Facture-only ("Jours avant retard"): dueDate is computed server-side as
  // issueDate + overdueAfterDays whenever the invoice moves to SENT — the
  // freelance sets a day count (default 5), never an absolute due date.
  // Ignored for QUOTE, which still uses a freely-picked absolute dueDate
  // (Échéance) feeding the EXPIRED sweep.
  overdueAfterDays      Int       @default(5)
  orderId               String?   @unique // set once a payment Order is created (Phase C)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Facture-only breakdown fields (INVOICE docType). Never set on a QUOTE —
  // enforced in the route handlers, not at the schema level.
  depositAmount     Int? // Acompte
  deliveryDate      DateTime? // Date de livraison — distinct from dueDate (payment due date)
  paymentMethodNote String? // Règlement — free text, e.g. "Orange Money +221..."
  footerNote        String? // Note de bas de page

  // Devis-only (QUOTE docType) — the freelance sector and project type this
  // devis is for, mirroring Project.sector/Project.type so an accepted devis
  // can pre-fill a new project with the same vocabulary (see
  // POST /api/invoices/[id]/create-project). Optional: devis created before
  // this field existed simply have both null, no backfill needed.
  sector String? // DESIGN | DEV | REDACTION | CONSULTING | VIDEO | COMMUNITY | OTHER
  type   String? // scoped to `sector` — see SECTOR_PROJECT_TYPES in lib/constants.ts

  // Devis-only free paragraph (QUOTE docType) — the intro text above the
  // structured payment-method content blocks, e.g. "Un acompte de 50% est
  // demandé avant le démarrage...". Distinct from paymentMethodNote above.
  paymentTermsNote String?

  // Devis-only (QUOTE docType) — the InvoicePack.id the client picked when
  // accepting via POST /api/track/[token]/validate. Offers are mutually
  // exclusive alternatives, not line items to sum: a devis with several
  // packs has no grand total anywhere in the UI, only each pack's own
  // subtotal — this field is what "the client chose offer X" actually
  // means once SENT -> ACCEPTED. Plain string (no @relation) since content
  // is frozen the moment a devis leaves DRAFT, so there's no risk of the
  // referenced pack being deleted out from under a stored selection.
  selectedPackId String?

  // Client Link Portal (Phase C pattern, extended here) — one token per
  // invoice/quote, same convention as Client.trackingToken/Project.publicToken.
  // The /api/track/[token] route only serves it once status != DRAFT (no
  // sharing a link to an unsent draft) — same anti-leak shape as the rest
  // of this app (404, not a distinct "not ready" error).
  trackingToken String @unique @default(cuid())

  // Set on a CREDIT_NOTE row only: the INVOICE it fully cancels. One-to-one
  // (an invoice can be canceled at most once — re-issue a new INVOICE for a
  // corrected amount rather than stacking credit notes). No hard delete of
  // invoices exists anywhere in this app by design — a credit note is the
  // only way to void one, preserving the audit trail.
  relatedInvoiceId String?  @unique
  relatedInvoice   Invoice? @relation("InvoiceCreditNote", fields: [relatedInvoiceId], references: [id])
  creditNote       Invoice? @relation("InvoiceCreditNote")

  // lineItems always carries invoiceId, even for a QUOTE's pack items — for
  // an INVOICE (packId always null) this is the flat prestations list; for a
  // QUOTE, always filter `where: { packId: null }` to get the (always empty)
  // flat subset, use `packs[].items` for the real per-pack lines instead.
  packs         InvoicePack[]
  lineItems     InvoiceLineItem[]
  contentBlocks QuoteContentBlock[] // QUOTE only

  @@unique([userId, docType, number])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([clientId])
  @@index([projectId])
}

// One pack/offer within a QUOTE's "Offres à passer" — a devis can present
// several selectable tiers, each with its own repeatable line items and
// subtotal. Never used for an INVOICE (which has a flat lineItems list
// instead, packId null throughout).
model InvoicePack {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order          Int
  title          String
  description    String?
  // Per-offer acompte, optional — a devis with several packs can ask a
  // different deposit for each since they're independent proposals, not
  // line items of one bill. null depositType = no deposit configured for
  // this offer. FIXED: depositValue is an amount in the invoice's smallest
  // currency unit. PERCENT: depositValue is a 0-100 integer rate applied to
  // this pack's own computeItemsTotal — never the (nonexistent) grand total.
  depositType    String? // FIXED | PERCENT
  depositValue   Int?
  // Freelance-chosen free text ("2 semaines", "10 jours") — no structured
  // duration parsing, the freelance picks whatever format makes sense to
  // them. Shown on the devis (freelance + client suivi + PDF) so a client
  // knows how long the offer they're picking actually takes.
  turnaroundTime String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items InvoiceLineItem[]

  @@index([invoiceId, order])
}

// A single prestation line (désignation/qté/prix). packId is set only for a
// QUOTE's pack-nested items; null means a flat INVOICE line.
model InvoiceLineItem {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  packId      String?
  pack        InvoicePack? @relation(fields: [packId], references: [id], onDelete: Cascade)
  order       Int
  designation String
  quantity    Int          @default(1)
  unitPrice   Int // integer, smallest currency unit — same money invariant as amount
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([invoiceId, order])
  @@index([packId, order])
}

// Additional devis content sections (Processus de travail / Conditions /
// Modalités de paiement / FAQ) — one generic {primaryText, secondaryText}
// shape reused across all four kinds rather than four separate tables,
// since they're all structurally an ordered list of two text fields
// (title+description, or label+value, or question+answer). QUOTE only.
// Each quote gets its own copy (not a shared reference) so editing one
// quote's content never affects another's — see the "last quote as
// template" pre-fill mechanism in the invoice creation route.
model QuoteContentBlock {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind          String // PROCESS | CONDITIONS | PAYMENT_METHOD | FAQ
  order         Int
  primaryText   String
  secondaryText String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([invoiceId, kind, order])
}

// The freelancer's own default payment methods (Paramètres → Facturation) —
// same {primaryText, secondaryText, order} shape as QuoteContentBlock's
// PAYMENT_METHOD kind, reused for two purposes: (1) pre-fills a brand-new
// devis's own PAYMENT_METHOD blocks (which the freelancer keeps as their own
// editable copy from then on, same "each quote owns its copy" invariant as
// QuoteContentBlock), and (2) a live fallback in GET /api/track/[token] for
// anything with no copy of its own — a standalone project with no origin
// devis, or a devis whose PAYMENT_METHOD block was left empty.
model DefaultPaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Int
  primaryText   String
  secondaryText String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, order])
}

// Client-submitted review — one per Project, collected via the Client Link
// Portal once the project reaches DELIVERED (POST /api/track/[token]/review,
// same token-is-the-authorization pattern as ProjectComment). Re-posting
// updates the existing row (upsert on projectId) rather than erroring — low
// stakes, no adversarial "frozen once sent" invariant needed here unlike
// Invoice. Denormalizes userId/clientId (not just projectId) so the
// freelancer-facing "Avis clients" list/aggregate never needs to join
// through Project for every row.
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([clientId])
}

// ───────────────────────────────────────────────────────────────────────
// SaaS subscription billing — the freelancer paying US for using the app,
// via FedaPay. Deliberately separate from Order (which models an end
// CLIENT paying the freelancer) and from PaymentProvider (that interface
// is shaped for the redirect-per-charge Order flow; FedaPay's adapter is
// its own thing — see lib/server/payments/fedapay.ts).
//
// FedaPay has no silent tokenized recharge — every renewal is its own
// redirect-confirmed transaction, so this is period-based with
// prompted/manual renewal, not true auto-billing. No row = implicit FREE
// plan (lazy-created on first read, see lib/server/billing/subscription.ts).
// ───────────────────────────────────────────────────────────────────────
model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String    @default("FREE") // FREE | PRO
  status            String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED | EXPIRED
  billingCycle      String? // MONTHLY | YEARLY — null while FREE
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions SubscriptionTransaction[]
}

model SubscriptionTransaction {
  id                    String       @id @default(cuid())
  subscriptionId        String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount                Int // smallest currency unit, matches Order convention
  currency              String       @default("XOF")
  billingCycle          String // MONTHLY | YEARLY
  status                String       @default("PENDING") // PENDING | PAID | FAILED | EXPIRED
  provider              String       @default("fedapay")
  providerTransactionId String?      @unique
  paymentUrl            String?
  idempotencyKey        String?      @unique
  periodStart           DateTime?
  periodEnd             DateTime?
  // Snapshot of the applied coupon code (if any) — denormalized for billing
  // history display; the authoritative redemption record is CouponRedemption.
  couponCode            String?
  // PENDING expiry — set at creation to match the provider's own checkout
  // session lifetime (~1h for SasPay). Not every failed real payment gets a
  // webhook (confirmed live 2026-08-24: an abandoned/declined checkout can
  // sit PENDING with no delivery at all), so this is the backstop the
  // subscription-transaction-expiration cron sweeps on. Nullable so
  // pre-existing rows are unaffected; not cleared on PAID/FAILED (history).
  expiresAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([subscriptionId, createdAt])
  @@index([status])
  @@index([status, expiresAt])
}

// Percentage- or fixed-amount-off discount codes, redeemable once per user
// (enforced by CouponRedemption's unique [couponId, userId]) and up to
// maxRedemptions times in total (null = unlimited), applied at checkout on
// POST /api/billing/subscribe (see lib/server/billing/coupons.ts).
// Immutable after creation (code/discountType/percentOff/amountOff/
// maxRedemptions never change) — a Super Admin who needs different terms
// deactivates this one and creates a new code, so past redemptions always
// reflect the terms that were actually honored.
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique // stored uppercase
  discountType    String    @default("PERCENT") // PERCENT | AMOUNT
  percentOff      Int? // 1-99, set when discountType = PERCENT
  amountOff       Int? // smallest currency unit (matches PlanConfig.currency), set when discountType = AMOUNT
  billingCycle    String? // MONTHLY | YEARLY | null = valid on both
  maxRedemptions  Int? // null = unlimited total uses across all users
  active          Boolean   @default(true)
  expiresAt       DateTime?
  redemptionCount Int       @default(0) // incremented on each successful redemption; enforced against maxRedemptions
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions CouponRedemption[]
}

// One row per (coupon, user) — enforces "one use per user per coupon" and
// is the source of truth for redemption checks (Coupon.redemptionCount is
// just a denormalized counter for admin display).
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model PlanConfig {
  id                String   @id @default(cuid())
  plan              String   @unique // FREE | PRO
  monthlyAmount     Int? // smallest currency unit; null for FREE
  yearlyAmount      Int? // null for FREE
  currency          String   @default("XOF")
  maxClients        Int? // FREE-tier limit; null = unlimited (PRO)
  maxActiveProjects Int? // FREE-tier limit; null = unlimited (PRO)
  maxInvoices       Int? // FREE-tier limit on docType=INVOICE rows; null = unlimited (PRO)
  maxQuotes         Int? // FREE-tier limit on docType=QUOTE rows; null = unlimited (PRO)
  features          String[] // marketing bullet list shown on pricing cards
  updatedAt         DateTime @updatedAt
}

// Single-row, site-wide config editable from Super Admin → Paramètres →
// Général. The row's id is a fixed literal ('default') instead of a
// cuid() — there is and will only ever be exactly one row, read via
// upsert-on-read (mirrors PlanConfig's own pattern above) so the first
// read seeds it.
model AppSettings {
  id                   String   @id @default("default")
  communityWhatsappUrl String? // shown on every "Rejoindre la communauté" WhatsApp button (landing page + dashboard banner)
  updatedAt            DateTime @updatedAt
}
